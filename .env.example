# --- Módulo de IA (Fase 2 - Saneamiento/Normalización) ---
# NVIDIA NIM expone un endpoint compatible con la API de OpenAI.
# Obtén tu API key en https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

# --- Fase 3 (Geocodificación) / Fase 4 (Ruteo) ---
# Por defecto se usan proveedores gratuitos basados en OpenStreetMap (sin key, sin tarjeta):
# Nominatim para geocodificación y OSRM para ruteo.
# Alternativas: "locationiq" (misma cobertura OSM, sin límite de 1 req/seg, gratis sin tarjeta:
# https://locationiq.com) o "google" (mejor precisión real, requiere facturación habilitada).
GEOCODING_PROVIDER=nominatim
ROUTING_PROVIDER=osrm

# Sesgo geográfico: departamento del Atlántico, Colombia (Barranquilla y municipios).
# Ajusta el viewbox si tu operación cubre otra región (formato: min_lon,max_lat,max_lon,min_lat).
NOMINATIM_COUNTRYCODES=co
NOMINATIM_VIEWBOX=-75.3,11.15,-74.6,10.1
NOMINATIM_BOUNDED=0

# Solo necesario si GEOCODING_PROVIDER=locationiq
LOCATIONIQ_API_KEY=

# Solo necesario si GEOCODING_PROVIDER=google o ROUTING_PROVIDER=google
GOOGLE_MAPS_API_KEY=

# --- Persistencia ---
DATABASE_PATH=data/output/rutas.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
