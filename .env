NOMINATIM_VIEWBOX=-75.3,11.15,-74.6,10.1
NOMINATIM_BOUNDED=0

# LocationIQ (gratis, sin tarjeta): obtén tu key en https://locationiq.com y pégala aquí,
# luego cambia GEOCODING_PROVIDER=locationiq arriba para activarlo.
